{
  "expo": {
    "name": "MapMeet",
    "slug": "mapmeet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mapmeet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0E10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mapmeet.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MapMeet uses your location to show nearby events on the map.",
        "NSPhotoLibraryUsageDescription": "MapMeet needs access to your photo library so you can set a profile picture.",
        "NSCameraUsageDescription": "MapMeet uses the camera so you can take a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0E0E10"
      },
      "package": "com.mapmeet.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_ANDROID_API_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MapMeet uses your location to show nearby events on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MapMeet needs access to your photo library so you can set a profile picture.",
          "cameraPermission": "MapMeet uses the camera so you can take a profile picture."
        }
      ],
      "expo-asset",
      "expo-font",
      "./plugins/withFmtConstevalFix"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "90246480-e1e3-4baa-b2e1-c4380f49f6f5"
      }
    },
    "owner": "hamud_habibi"
  }
}
