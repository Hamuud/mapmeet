# Supabase — get these from your project dashboard (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional — used by the Android native Google Maps SDK. Also mirror this into
# app.json → expo.android.config.googleMaps.apiKey when you build for Android.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# Optional — used by the MapLibre web renderer for vector tiles. If left blank
# the web map falls back to the OpenStreetMap raster preset.
EXPO_PUBLIC_MAPLIBRE_STYLE_URL=

# Optional — RevenueCat PUBLIC SDK keys (Project → API keys → App-specific).
# These are meant to ship inside the app: they can start a purchase and read
# entitlements, and nothing else. Leave blank and premium simply isn't for sale
# in that build; everything else works. The SECRET key (sk_…) belongs only in
# the subscription-sync Edge Function — never here, never in the repo.
#
# A `test_…` Test Store key works for local development without any App Store
# setup, but the SDK CRASHES a release build that starts with one. The service
# ignores a test_ key unless __DEV__, so leaving it here is safe — just make
# sure the EAS secret holds the real appl_… key before a TestFlight build.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
